<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>my.company.com</groupId>
  <artifactId>sinch-getting-started-voice-outbound-text-to-speech</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>Getting Started: place an outbound text-to-speech call with Voice API v2</name>

  <profiles>
    <profile>
      <id>use-version</id>
      <properties>
        <sinch.sdk.java.version>${env.SDK_VERSION}</sinch.sdk.java.version>
      </properties>
    </profile>
  </profiles>

  <properties>
    <!-- Voice API v2 helpers are available since 2.4.0 -->
    <sinch.sdk.java.version>[2.4.0,)</sinch.sdk.java.version>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Class run by "mvn compile exec:java"; override it with -Dexec.mainClass=... -->
    <exec.mainClass>Callout</exec.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.sinch.sdk</groupId>
      <artifactId>sinch-sdk-java</artifactId>
      <version>${sinch.sdk.java.version}</version>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
      <version>2.0.9</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
    </plugins>
  </build>

</project>
