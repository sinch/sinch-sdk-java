<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/> <!-- lookup parent from repository -->
  </parent>

  <groupId>my.company.com</groupId>
  <artifactId>sinch-getting-started-voice-track-call-status</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>Getting Started: track call status with events and polling with Voice API v2</name>

  <profiles>
    <profile>
      <id>use-version</id>
      <properties>
        <sinch.sdk.java.version>${env.SDK_VERSION}</sinch.sdk.java.version>
      </properties>
    </profile>
  </profiles>

  <properties>
    <!-- Voice API v2 helpers are available since 2.4.0 -->
    <sinch.sdk.java.version>[2.4.0,)</sinch.sdk.java.version>
    <java.version>21</java.version>
    <!-- Class run by "mvn spring-boot:run" -->
    <start-class>com.mycompany.app.Application</start-class>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>com.sinch.sdk</groupId>
      <artifactId>sinch-sdk-java</artifactId>
      <version>${sinch.sdk.java.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Runs the standalone scripts: "mvn compile exec:java -Dexec.mainClass=..." -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
    </plugins>
  </build>

</project>
